# Copy to .env and fill in for LIVE trading only.
# Default mode is PAPER — do not set LIVE until you understand the risk model.

ATLAS_MODE=PAPER

# Required only for LIVE on a Windows host with MetaTrader 5 installed:
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=YourBroker-Server
# MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
