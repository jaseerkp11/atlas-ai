# ATLAS mode:
#   PAPER = live MT5 prices (when connected) + simulated orders only
#   LIVE  = live MT5 prices + real broker orders (money at risk)
ATLAS_MODE=PAPER

# Fill these so Python can attach to your open MetaTrader 5 terminal.
# Find Login / Server at the bottom of the MT5 window (or Tools → Options → Server).
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
