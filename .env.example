# LIVE = real order_send to the connected MT5 account (use demo first).
# PAPER = live MT5 prices + simulated orders only.
ATLAS_MODE=LIVE

# Must match the account logged into MetaTrader 5:
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
