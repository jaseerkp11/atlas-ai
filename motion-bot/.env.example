# X API credentials (Developer Portal → App → Keys and tokens)
# App must have Read and Write permissions.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# true = print posts only, false = publish to X
DRY_RUN=true

# Override config.yaml interval (seconds)
# INTERVAL_SECONDS=60
